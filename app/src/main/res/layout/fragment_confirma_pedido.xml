<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_check_circle"
            android:background="@color/verde_arthur"
            android:padding="12dp"
            app:tint="@color/branco"
            android:contentDescription="Sucesso"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedido Confirmado!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/verde_arthur"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvNumeroPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#000000"
            android:textSize="16sp"
            android:textColor="@color/texto_primario"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvObrigado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Obrigado pela compra! Acompanhe o status em Meus Pedidos."
            android:textColor="@color/cinza_texto"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumo do pedido"
            android:textStyle="bold"
            android:textColor="@color/verde_arthur"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/containerItens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/superficie" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal"
                    android:textColor="@color/cinza_texto" />
                <TextView
                    android:id="@+id/tvSubtotalConf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textColor="@color/texto_primario" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Frete"
                    android:textColor="@color/cinza_texto" />
                <TextView
                    android:id="@+id/tvFreteConf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textColor="@color/texto_primario" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/texto_primario" />
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/rosa_arthur" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VOLTAR PARA O INÍCIO"
            android:backgroundTint="@color/rosa_arthur"
            android:textColor="@color/branco"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>