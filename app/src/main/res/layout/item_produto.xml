<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/branco">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgProduto"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:background="@color/superficie"
                android:contentDescription="Imagem do produto" />

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do produto"
                android:padding="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/texto_primario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPreco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/rosa_arthur"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSeloPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROMO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="@color/rosa_arthur"
            android:padding="4dp"
            android:layout_gravity="top|start"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSeloEsgotado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESGOTADO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="#64748B"
            android:padding="4dp"
            android:layout_gravity="bottom|start"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnFavorito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textSize="24sp"
            android:textColor="@color/rosa_arthur"
            android:padding="6dp"
            android:layout_gravity="top|end"
            android:background="#88FFFFFF" />
    </FrameLayout>
</androidx.cardview.widget.CardView>