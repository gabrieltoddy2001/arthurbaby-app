<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ATALHO DE BUSCA -->
        <LinearLayout
            android:id="@+id/atalhoBusca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/branco"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_busca"
                android:contentDescription="Buscar"
                app:tint="@color/cinza_texto"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar produtos..."
                android:textColor="@color/cinza_texto"
                android:textSize="15sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- SAUDAÇÃO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá!"
            android:textColor="@color/texto_primario"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O que você procura hoje?"
            android:textColor="@color/cinza_texto" />

        <!-- BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/verde_arthur"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BANNER"
                android:textColor="@color/branco"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promoções da semana"
                android:textColor="@color/branco"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- BOTÃO PROMOÇÕES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPromocoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VER PROMOÇÕES"
            android:backgroundTint="@color/rosa_arthur"
            android:textColor="@color/branco"
            android:layout_marginTop="12dp"
            app:icon="@drawable/ic_promocao"
            app:iconTint="@color/branco"
            app:iconGravity="textStart"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- CATEGORIAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categorias"
            android:textColor="@color/verde_arthur"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- DESTAQUES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destaques"
            android:textColor="@color/verde_arthur"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDestaques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>