<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Botão "voltar" padrão dos cabeçalhos: área de toque de 48dp e seta larga -->
    <style name="BotaoVoltar">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">-12dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_voltar</item>
        <item name="tint">@color/texto_primario</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">Voltar</item>
        <item name="android:tooltipText">Voltar</item>
    </style>
</resources>
