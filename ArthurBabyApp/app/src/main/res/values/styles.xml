<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Botão "voltar" padrão dos cabeçalhos: área de toque de 48dp e seta larga -->
    <style name="BotaoVoltar">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">-12dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_voltar</item>
        <item name="tint">@color/texto_primario</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:contentDescription">Voltar</item>
        <item name="android:tooltipText">Voltar</item>
    </style>

    <!-- Campo de texto com cantos arredondados (mesmo padrão do login) -->
    <style name="CampoArredondado" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/rosa_arthur</item>
        <item name="hintTextColor">@color/rosa_arthur</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Diálogos (modais) com bordas arredondadas e botões nas cores do app -->
    <style name="DialogArredondado" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/FormaDialogArredondado</item>
        <item name="colorPrimary">@color/rosa_arthur</item>
        <item name="colorSurface">@color/branco</item>
    </style>

    <style name="FormaDialogArredondado" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
