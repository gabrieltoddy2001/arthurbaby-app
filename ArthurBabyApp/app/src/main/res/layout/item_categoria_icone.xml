<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="2dp"
    android:paddingVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/frameIcone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_circulo_categoria">

        <ImageView
            android:id="@+id/imgIcone"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cat_enxoval"
            android:contentDescription="Categoria" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enxoval"
        android:textColor="@color/texto_primario"
        android:textSize="11sp"
        android:gravity="center"
        android:lines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginTop="6dp" />
</LinearLayout>