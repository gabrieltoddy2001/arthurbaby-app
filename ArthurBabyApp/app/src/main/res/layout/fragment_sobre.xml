<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_gradiente_header">

            <ImageButton
                android:id="@+id/btnVoltar"
                style="@style/BotaoVoltar"
                app:tint="@color/branco_fixo" />

            <br.com.arthurbaby.utils.TituloComIcone
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sobre"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold"
                android:textColor="@color/branco_fixo"
                app:iconeTitulo="@drawable/ic_info"
            app:iconeClaro="true" />


            <Space

                android:layout_width="0dp"

                android:layout_height="1dp"

                android:layout_weight="1" />
        </LinearLayout>

        <!-- HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_gradiente_header">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_circulo_branco_suave"
                android:elevation="4dp">

                <br.com.arthurbaby.utils.LogoAnimadoView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arthurbaby_2"
                android:textStyle="bold"
                android:textSize="@dimen/texto_titulo"
                android:textColor="@color/branco_fixo"
                android:letterSpacing="0.1"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enxoval_e_moda_infantil"
                android:textColor="@color/branco_fixo"
                android:textSize="@dimen/texto_corpo"
                android:alpha="0.9" />

            <TextView
                android:id="@+id/tvVersao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/versao_1_0"
                android:textColor="@color/branco_fixo"
                android:textSize="@dimen/texto_pequeno"
                android:alpha="0.8"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- CONTATO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contato"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:textSize="@dimen/texto_destaque"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/branco">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:id="@+id/tvWhatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_verde_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_whatsapp"
                            app:tint="@color/verde_arthur"
                            android:contentDescription="@string/whatsapp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/n_71_99131_1944"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_categoria_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_email"
                            app:tint="@color/rosa_arthur"
                            android:contentDescription="@string/e_mail" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pedidoababy_gmail_com"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_verde_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_localizacao"
                            app:tint="@color/verde_arthur"
                            android:contentDescription="@string/endereco" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/av_sete_de_setembro_548_salvador_ba"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- REDES SOCIAIS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/siga_a_gente"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            android:textSize="@dimen/texto_destaque"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/branco">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:id="@+id/tvInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_categoria_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_instagram"
                            app:tint="@color/rosa_arthur"
                            android:contentDescription="@string/instagram" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@lojao_arthur_baby"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvShopee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_verde_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shopee"
                            app:tint="@color/verde_arthur"
                            android:contentDescription="@string/shopee" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arthurbabylojao"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvFacebook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circulo_categoria_suave">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_info"
                            app:tint="@color/rosa_arthur"
                            android:contentDescription="@string/facebook" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lojao_arthur_baby"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- COPYRIGHT (o ano é preenchido pelo SobreFragment) -->
        <TextView
            android:id="@+id/tvRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rodape_sobre"
            android:gravity="center"
            android:textColor="@color/cinza_texto"
            android:textSize="@dimen/texto_pequeno"
            android:lineSpacingMultiplier="1.4"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp" />
    </LinearLayout>
</ScrollView>