<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/branco">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgProduto"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@color/rosa_suave"
                android:contentDescription="@string/imagem_do_produto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nome_do_produto"
                    android:minLines="2"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/texto_primario"
                    android:textSize="@dimen/texto_corpo"
                    android:lineSpacingMultiplier="1.1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvEstrelas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto"
                        android:textColor="@color/amarelo_estrela"
                        android:textSize="@dimen/texto_pequeno" />

                    <TextView
                        android:id="@+id/tvAvaliacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/n_5"
                        android:textColor="@color/cinza_texto"
                        android:textSize="@dimen/texto_mini"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvPreco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/r_0_00"
                        android:textColor="@color/rosa_arthur"
                        android:textStyle="bold"
                        android:textSize="@dimen/texto_destaque" />

                    <TextView
                        android:id="@+id/tvPrecoAntigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/cinza_texto"
                        android:textSize="@dimen/texto_mini"
                        android:visibility="gone"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- CORAÇÃO -->
        <ImageView
            android:id="@+id/btnFavorito"
            android:tooltipText="Adicionar aos favoritos"
            android:contentDescription="@string/adicionar_aos_favoritos"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:padding="7dp"
            android:background="@drawable/bg_circulo_branco_suave"
            android:src="@drawable/ic_favorito"
            app:tint="@color/coracao_inativo" />

        <!-- SELO PROMO -->
        <TextView
            android:id="@+id/tvSeloPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/promo"
            android:textSize="@dimen/texto_mini"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="@drawable/bg_selo_promo"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:visibility="gone" />

        <!-- SELO ESGOTADO -->
        <TextView
            android:id="@+id/tvSeloEsgotado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/esgotado"
            android:textSize="@dimen/texto_mini"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="@drawable/bg_selo_esgotado"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:visibility="gone" />
    </FrameLayout>
</androidx.cardview.widget.CardView>