<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/branco">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgProduto"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="@color/rosa_suave"
                android:contentDescription="Imagem do produto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nome do produto"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/texto_primario"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvEstrelas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★★★★★"
                        android:textColor="@color/amarelo_estrela"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAvaliacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(5)"
                        android:textColor="@color/cinza_texto"
                        android:textSize="11sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvPreco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textColor="@color/rosa_arthur"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPrecoAntigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/cinza_texto"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- CORAÇÃO -->
        <ImageView
            android:id="@+id/btnFavorito"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_circulo_branco_suave"
            android:src="@drawable/ic_favorito"
            app:tint="@color/coracao_inativo"
            android:contentDescription="Favorito" />

        <!-- SELO PROMO -->
        <TextView
            android:id="@+id/tvSeloPromocao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROMO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="@drawable/bg_selo_promo"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <!-- SELO ESGOTADO -->
        <TextView
            android:id="@+id/tvSeloEsgotado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESGOTADO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:background="@drawable/bg_selo_esgotado"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:visibility="gone" />
    </FrameLayout>
</androidx.cardview.widget.CardView>