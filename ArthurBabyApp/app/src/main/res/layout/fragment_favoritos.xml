<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradiente_header">

        <ImageButton
            android:id="@+id/btnVoltar"
            style="@style/BotaoVoltar"
            app:tint="@color/branco" />

        <br.com.arthurbaby.utils.TituloComIcone
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favoritos"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold"
            android:textColor="@color/branco"
            app:iconeTitulo="@drawable/ic_favorito"
            app:iconeClaro="true" />


        <Space

            android:layout_width="0dp"

            android:layout_height="1dp"

            android:layout_weight="1" />
    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/rosa_arthur"
        android:visibility="gone" />

    <!-- ESTADO VAZIO -->
    <LinearLayout
        android:id="@+id/tvVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circulo_empty">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorito"
                app:tint="@color/rosa_arthur"
                android:contentDescription="@string/sem_favoritos" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVazioTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voce_ainda_nao_tem_favoritos"
            android:textColor="@color/texto_primario"
            android:textStyle="bold"
            android:textSize="@dimen/texto_subtitulo"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toque_no_dos_produtos_que_voce_mais_gost"
            android:textColor="@color/cinza_medio"
            android:textSize="@dimen/texto_corpo"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- LISTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoritos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false"
        android:visibility="gone" />
</LinearLayout>