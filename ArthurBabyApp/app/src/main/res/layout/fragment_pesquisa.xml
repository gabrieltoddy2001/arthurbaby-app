<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO (mesmo degradê verde → rosa da Home) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_gradiente_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoltarBusca"
                style="@style/BotaoVoltar"
                app:tint="@color/branco" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <br.com.arthurbaby.utils.TituloComIcone
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscar"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/branco"
                    app:iconeTitulo="@drawable/ic_busca"

                    app:iconeClaro="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encontre tudo para o seu bebê 💕"
                    android:textSize="12sp"
                    android:alpha="0.9"
                    android:textColor="@color/branco" />
            </LinearLayout>
        </LinearLayout>

        <!-- CAMPO DE BUSCA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_suave"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_busca"
                app:tint="@color/rosa_arthur"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/etBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:hint="Roupinhas, enxoval, acessórios..."
                android:textColorHint="@color/cinza_texto"
                android:textColor="@color/texto_primario"
                android:background="@android:color/transparent"
                android:paddingStart="10dp"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- CHIPS DE FILTRO -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipPromocao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promoção"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipBaratos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Até R$ 50"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/rosa_escuro"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- BUSCAS RECENTES (visível só quando o campo está vazio) -->
    <LinearLayout
        android:id="@+id/containerHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buscas recentes"
                android:textColor="@color/texto_primario"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnLimparHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@color/rosa_arthur"
                android:textSize="12sp"
                android:padding="4dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerChipsHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- INFO RESULTADOS -->
    <TextView
        android:id="@+id/tvResultadoInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite para buscar"
        android:textColor="@color/cinza_medio"
        android:textSize="13sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp" />

    <!-- ESTADO VAZIO: ilustração suave (carrinho de bebê) -->
    <ScrollView
        android:id="@+id/estadoVazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/ic_busca_bebe"
                android:contentDescription="Carrinho de bebê" />

            <TextView
                android:id="@+id/tvVazioTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="O que o seu bebê precisa hoje?"
                android:textColor="@color/rosa_escuro"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvVazioTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Busque roupinhas, enxoval, acessórios e muito mais — feito com carinho para você."
                android:textColor="@color/cinza_medio"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/verde_arthur"
        android:visibility="gone" />

    <!-- RESULTADOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
