<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO (mesmo degradê verde → rosa da Home) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_gradiente_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoltarBusca"
                style="@style/BotaoVoltar"
                app:tint="@color/branco_fixo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <br.com.arthurbaby.utils.TituloComIcone
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buscar"
                    android:textSize="@dimen/texto_subtitulo"
                    android:textStyle="bold"
                    android:textColor="@color/branco_fixo"
                    app:iconeTitulo="@drawable/ic_busca"

                    app:iconeClaro="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/encontre_tudo_para_o_seu_bebe"
                    android:textSize="@dimen/texto_pequeno"
                    android:alpha="0.9"
                    android:textColor="@color/branco_fixo" />
            </LinearLayout>
        </LinearLayout>

        <!-- CAMPO DE BUSCA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_suave"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_busca"
                app:tint="@color/rosa_arthur"
                android:contentDescription="@string/buscar" />

            <EditText
                android:id="@+id/etBusca"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:hint="@string/roupinhas_enxoval_acessorios"
                android:textColorHint="@color/cinza_texto"
                android:textColor="@color/texto_primario"
                android:background="@android:color/transparent"
                android:paddingStart="10dp"
                android:textSize="@dimen/texto_corpo"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <!-- Histórico: abre/fecha as buscas recentes a qualquer momento -->
            <ImageView
                android:id="@+id/btnHistoricoBusca"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_historico"
                app:tint="@color/rosa_arthur"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:tooltipText="Buscas recentes"
                android:contentDescription="@string/buscas_recentes" />
        </LinearLayout>
    </LinearLayout>

    <!-- CHIPS DE FILTRO -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todas"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="@dimen/texto_corpo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipPromocao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/promocao"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="@dimen/texto_corpo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipBaratos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ate_r_50"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="@dimen/texto_corpo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limpar"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/rosa_escuro"
                android:textSize="@dimen/texto_corpo" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- BUSCAS RECENTES (aparece ao abrir a tela e com o campo vazio; o botão de histórico da barra abre/fecha) -->
    <LinearLayout
        android:id="@+id/containerHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/buscas_recentes"
                android:textColor="@color/texto_primario"
                android:textStyle="bold"
                android:textSize="@dimen/texto_corpo" />

            <TextView
                android:id="@+id/btnLimparHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limpar"
                android:textColor="@color/rosa_arthur"
                android:textSize="@dimen/texto_pequeno"
                android:padding="4dp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerChipsHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- INFO RESULTADOS -->
    <TextView
        android:id="@+id/tvResultadoInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/cinza_medio"
        android:textSize="@dimen/texto_corpo"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp" />

    <!-- ESTADO VAZIO: ilustração suave (carrinho de bebê) -->
    <ScrollView
        android:id="@+id/estadoVazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/ic_busca_bebe"
                android:contentDescription="@string/carrinho_de_bebe" />

            <TextView
                android:id="@+id/tvVazioTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/o_que_o_seu_bebe_precisa_hoje"
                android:textColor="@color/rosa_escuro"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvVazioTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/busque_roupinhas_enxoval_acessorios_e_mu"
                android:textColor="@color/cinza_medio"
                android:textSize="@dimen/texto_corpo"
                android:lineSpacingMultiplier="1.2"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/verde_arthur"
        android:visibility="gone" />

    <!-- RESULTADOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
