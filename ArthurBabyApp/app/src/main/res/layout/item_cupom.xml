<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="@color/rosa_arthur" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/codigo"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold"
                android:textColor="@color/rosa_arthur" />

            <TextView
                android:id="@+id/tvDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/descricao_do_cupom"
                android:textSize="@dimen/texto_corpo"
                android:textColor="@color/texto_primario"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvValidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/valido_ate_31_12_2026"
                android:textSize="@dimen/texto_pequeno"
                android:textColor="@color/cinza_medio"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>