<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradiente_header">

        <ImageButton
            android:id="@+id/btnVoltarCategorias"
            style="@style/BotaoVoltar"
            app:tint="@color/branco_fixo" />

        <br.com.arthurbaby.utils.TituloComIcone
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categorias"
            android:textColor="@color/branco_fixo"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold"
            app:iconeTitulo="@drawable/ic_categorias"
            app:iconeClaro="true" />
    </LinearLayout>

    <!-- BUSCA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_suave"
            android:padding="14dp"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_busca"
                app:tint="@color/rosa_arthur"
                android:contentDescription="@string/buscar" />

            <TextView
                android:id="@+id/atalhoBuscaCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buscar_produtos"
                android:textColor="@color/cinza_texto"
                android:textSize="@dimen/texto_corpo"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- PROGRESS BAR (inicia VISÍVEL) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/verde_arthur"
        android:visibility="visible" />

    <!-- LISTA (inicia ESCONDIDA) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategorias"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>