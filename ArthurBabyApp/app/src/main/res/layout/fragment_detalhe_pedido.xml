<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO BRANCO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/branco">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="26sp"
                android:textColor="@color/texto_primario"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pedido"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textStyle="bold"
                android:textColor="@color/branco"
                android:background="@color/rosa_arthur"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Itens"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/containerItens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/branco"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- RESUMO FINANCEIRO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- SUBTOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="@color/cinza_medio" />
                        <TextView
                            android:id="@+id/tvSubtotalDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textColor="@color/texto_primario" />
                    </LinearLayout>

                    <!-- DESCONTO -->
                    <LinearLayout
                        android:id="@+id/rowDescontoDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvLabelDescontoDetalhe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Desconto"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDescontoDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- R$ 0,00"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- FRETE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Frete"
                            android:textColor="@color/cinza_medio" />
                        <TextView
                            android:id="@+id/tvFreteDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textColor="@color/texto_primario" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cinza_borda"
                        android:layout_marginVertical="10dp" />

                    <!-- TOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/texto_primario" />
                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Histórico de status"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/containerHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/branco"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- BOTÃO CANCELAR PEDIDO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarPedido"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="CANCELAR PEDIDO"
                android:backgroundTint="@color/vermelho_desconto"
                android:textColor="@color/branco"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>