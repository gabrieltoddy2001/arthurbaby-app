<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO BRANCO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_gradiente_header">

            <ImageButton
                android:id="@+id/btnVoltar"
                style="@style/BotaoVoltar"
                app:tint="@color/branco_fixo" />

            <br.com.arthurbaby.utils.TituloComIcone
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pedido"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold"
                android:textColor="@color/branco_fixo"
                app:iconeTitulo="@drawable/ic_pedidos"
            app:iconeClaro="true" />


            <Space

                android:layout_width="0dp"

                android:layout_height="1dp"

                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                android:textStyle="bold"
                android:textColor="@color/branco_fixo"
                android:background="@color/rosa_arthur"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/itens"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/containerItens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/branco"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- RESUMO FINANCEIRO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resumo"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- SUBTOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/subtotal"
                            android:textColor="@color/cinza_medio" />
                        <TextView
                            android:id="@+id/tvSubtotalDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textColor="@color/texto_primario" />
                    </LinearLayout>

                    <!-- DESCONTO -->
                    <LinearLayout
                        android:id="@+id/rowDescontoDetalhe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvLabelDescontoDetalhe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/desconto"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDescontoDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00_2"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- FRETE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/frete"
                            android:textColor="@color/cinza_medio" />
                        <TextView
                            android:id="@+id/tvFreteDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textColor="@color/texto_primario" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cinza_borda"
                        android:layout_marginVertical="10dp" />

                    <!-- TOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_subtitulo"
                            android:textColor="@color/texto_primario" />
                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_subtitulo"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historico_de_status"
                android:textStyle="bold"
                android:textColor="@color/verde_arthur"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/containerHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/branco"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- BOTÃO CANCELAR PEDIDO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarPedido"
                android:tooltipText="Cancelar este pedido"
                android:contentDescription="@string/cancelar_este_pedido"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/cancelar_pedido"
                android:backgroundTint="@color/vermelho_desconto"
                android:textColor="@color/branco_fixo"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>