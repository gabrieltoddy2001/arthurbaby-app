<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/branco">

        <ImageButton
            android:id="@+id/btnVoltar"
            style="@style/BotaoVoltar"
            app:tint="@color/texto_primario" />

        <br.com.arthurbaby.utils.TituloComIcone
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meus Pedidos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_primario"
            app:iconeTitulo="@drawable/ic_pedidos" />


        <Space

            android:layout_width="0dp"

            android:layout_height="1dp"

            android:layout_weight="1" />

        <!-- BOTÃO DE FILTRO -->
        <ImageView
            android:id="@+id/btnFiltrar"
            android:tooltipText="Filtrar pedidos"
            android:contentDescription="Filtrar pedidos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_filtro"
            app:tint="@color/texto_primario" />
    </LinearLayout>

    <!-- BARRA DE FILTRO ATIVO -->
    <LinearLayout
        android:id="@+id/containerFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/branco"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFiltroAtivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtro ativo: ..."
            android:textColor="@color/texto_primario"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLimparFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpar"
            android:textColor="@color/rosa_arthur"
            android:textStyle="bold"
            android:textSize="12sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/verde_arthur"
        android:visibility="visible" />

    <!-- ABAS + VIEWPAGER -->
    <LinearLayout
        android:id="@+id/containerPedidos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            app:tabIndicatorColor="@color/rosa_arthur"
            app:tabSelectedTextColor="@color/rosa_arthur"
            app:tabTextColor="@color/cinza_medio"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>