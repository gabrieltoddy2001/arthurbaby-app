<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradiente_header">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_carrinho"
            app:tint="@color/branco"
            android:contentDescription="Carrinho" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meu Carrinho"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvContadorItens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 itens"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:alpha="0.9" />
        </LinearLayout>
    </LinearLayout>

    <!-- ESTADO VAZIO -->
    <LinearLayout
        android:id="@+id/tvVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circulo_empty">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_carrinho"
                app:tint="@color/rosa_arthur"
                android:contentDescription="Carrinho vazio" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seu carrinho está vazio"
            android:textColor="@color/texto_primario"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Que tal adicionar produtos do nosso catálogo?"
            android:textColor="@color/cinza_medio"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarrinho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- FORMA DE RECEBIMENTO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forma de recebimento"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <RadioGroup
                        android:id="@+id/rgRecebimento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbRetirada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Retirar na loja"
                            android:textSize="13sp"
                            android:checked="true"
                            android:buttonTint="@color/rosa_arthur" />

                        <RadioButton
                            android:id="@+id/rbEntrega"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entrega"
                            android:textSize="13sp"
                            android:buttonTint="@color/rosa_arthur"
                            android:layout_marginStart="16dp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CUPOM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cupom de desconto"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/etCupom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Digite o cupom"
                            android:background="@drawable/bg_contador_quantidade"
                            android:padding="12dp"
                            android:inputType="text"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAplicarCupom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aplicar"
                            android:backgroundTint="@color/rosa_arthur"
                            android:textColor="@color/branco"
                            android:layout_marginStart="8dp"
                            android:textSize="13sp"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- OBSERVAÇÃO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observação"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etObservacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Alguma observação sobre o pedido?"
                        android:background="@drawable/bg_contador_quantidade"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:gravity="top"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RESUMO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="@color/cinza_medio"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textColor="@color/texto_primario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Frete"
                            android:textColor="@color/cinza_medio"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvFrete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textColor="@color/texto_primario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDesconto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Desconto"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvDesconto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- R$ 0,00"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cinza_borda"
                        android:layout_marginVertical="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/texto_primario" />
                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTÃO FINALIZAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="FINALIZAR PEDIDO"
        android:backgroundTint="@color/rosa_arthur"
        android:textColor="@color/branco"
        android:textStyle="bold"
        android:textSize="14sp"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="@color/branco"
        app:iconGravity="textStart" />

</LinearLayout>