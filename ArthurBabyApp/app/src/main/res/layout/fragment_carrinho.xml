<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_gradiente_header">

        <ImageButton
            android:id="@+id/btnVoltarCarrinho"
            style="@style/BotaoVoltar"
            app:tint="@color/branco" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <br.com.arthurbaby.utils.TituloComIcone
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/meu_carrinho"
                android:textColor="@color/branco"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold"
                app:iconeTitulo="@drawable/ic_carrinho"

                app:iconeClaro="true" />

            <TextView
                android:id="@+id/tvContadorItens"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/n_0_itens"
                android:textColor="@color/branco"
                android:textSize="@dimen/texto_pequeno"
                android:alpha="0.9" />
        </LinearLayout>
    </LinearLayout>

    <!-- ESTADO VAZIO -->
    <LinearLayout
        android:id="@+id/tvVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circulo_empty">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_carrinho"
                app:tint="@color/rosa_arthur"
                android:contentDescription="@string/carrinho_vazio" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seu_carrinho_esta_vazio"
            android:textColor="@color/texto_primario"
            android:textStyle="bold"
            android:textSize="@dimen/texto_subtitulo"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/que_tal_adicionar_produtos_do_nosso_cata"
            android:textColor="@color/cinza_medio"
            android:textSize="@dimen/texto_corpo"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCarrinho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- CHECKOUT (escondido com o carrinho vazio) -->
            <LinearLayout
                android:id="@+id/layoutCheckout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- FORMA DE RECEBIMENTO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_de_recebimento"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo" />

                    <RadioGroup
                        android:id="@+id/rgRecebimento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbRetirada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/retirar_na_loja"
                            android:textSize="@dimen/texto_corpo"
                            android:checked="true"
                            android:buttonTint="@color/rosa_arthur" />

                        <RadioButton
                            android:id="@+id/rbEntrega"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/entrega"
                            android:textSize="@dimen/texto_corpo"
                            android:buttonTint="@color/rosa_arthur"
                            android:layout_marginStart="16dp" />
                    </RadioGroup>

                    <!-- ENDEREÇO DE ENTREGA (só com "Entrega" marcada) -->
                    <LinearLayout
                        android:id="@+id/layoutEnderecoEntrega"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/cinza_borda"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/endereco_de_entrega"
                                android:textStyle="bold"
                                android:textColor="@color/texto_primario"
                                android:textSize="@dimen/texto_corpo" />

                            <TextView
                                android:id="@+id/btnTrocarEndereco"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/trocar"
                                android:textColor="@color/rosa_arthur"
                                android:textStyle="bold"
                                android:textSize="@dimen/texto_corpo"
                                android:padding="6dp"
                                android:contentDescription="@string/escolher_outro_endereco_de_entrega" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvEnderecoEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/carregando_seus_enderecos"
                            android:textColor="@color/cinza_medio"
                            android:textSize="@dimen/texto_corpo"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CUPOM -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cupom_de_desconto"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/etCupom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/digite_o_cupom"
                            android:background="@drawable/bg_contador_quantidade"
                            android:padding="12dp"
                            android:inputType="text"
                            android:textSize="@dimen/texto_corpo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAplicarCupom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aplicar"
                            android:backgroundTint="@color/rosa_arthur"
                            android:textColor="@color/branco"
                            android:layout_marginStart="8dp"
                            android:textSize="@dimen/texto_corpo"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- OBSERVAÇÃO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/observacao"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo" />

                    <EditText
                        android:id="@+id/etObservacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/alguma_observacao_sobre_o_pedido"
                        android:background="@drawable/bg_contador_quantidade"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:gravity="top"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RESUMO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/subtotal"
                            android:textColor="@color/cinza_medio"
                            android:textSize="@dimen/texto_corpo" />
                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textColor="@color/texto_primario"
                            android:textSize="@dimen/texto_corpo" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/frete"
                            android:textColor="@color/cinza_medio"
                            android:textSize="@dimen/texto_corpo" />
                        <TextView
                            android:id="@+id/tvFrete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textColor="@color/texto_primario"
                            android:textSize="@dimen/texto_corpo" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDesconto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/desconto"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_corpo" />
                        <TextView
                            android:id="@+id/tvDesconto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00_2"
                            android:textColor="@color/verde_arthur"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_corpo" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/cinza_borda"
                        android:layout_marginVertical="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_subtitulo"
                            android:textColor="@color/texto_primario" />
                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textStyle="bold"
                            android:textSize="@dimen/texto_subtitulo"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTÃO FINALIZAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/finalizar_pedido"
        android:backgroundTint="@color/rosa_arthur"
        android:textColor="@color/branco"
        android:textStyle="bold"
        android:textSize="@dimen/texto_corpo"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="@color/branco"
        app:iconGravity="textStart" />

</LinearLayout>