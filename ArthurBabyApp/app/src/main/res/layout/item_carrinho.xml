<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/branco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- IMAGEM -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circulo_categoria_suave">

            <ImageView
                android:id="@+id/imgProduto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/produto" />
        </FrameLayout>

        <!-- INFO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nome"
                android:textColor="@color/texto_primario"
                android:textStyle="bold"
                android:textSize="@dimen/texto_corpo"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvVariacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/cinza_texto"
                android:textSize="@dimen/texto_pequeno"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPreco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r_0_00"
                android:textColor="@color/rosa_arthur"
                android:textStyle="bold"
                android:textSize="@dimen/texto_destaque"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- AÇÕES -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <ImageView
                android:id="@+id/btnRemover"
                android:tooltipText="Remover item do carrinho"
                android:contentDescription="@string/remover_item_do_carrinho"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_lixeira"
                app:tint="@color/vermelho_desconto" />

            <!-- QUANTIDADE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_contador_quantidade"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenos"
                    android:tooltipText="Diminuir quantidade"
                    android:contentDescription="@string/diminuir_quantidade"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="@string/texto_2"
                    android:textSize="@dimen/texto_corpo"
                    android:backgroundTint="@color/branco"
                    android:textColor="@color/rosa_arthur"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="16dp" />

                <TextView
                    android:id="@+id/tvQtd"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/n_1"
                    android:textStyle="bold"
                    android:textColor="@color/texto_primario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMais"
                    android:tooltipText="Aumentar quantidade"
                    android:contentDescription="@string/aumentar_quantidade"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="@string/texto_3"
                    android:textSize="@dimen/texto_corpo"
                    android:backgroundTint="@color/branco"
                    android:textColor="@color/rosa_arthur"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>