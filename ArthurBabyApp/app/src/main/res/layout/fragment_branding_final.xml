<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco_quente">

    <!-- Curvas decorativas -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-160dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_splash_top" />

    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-220dp"
        android:layout_marginStart="-150dp"
        android:background="@drawable/bg_splash_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_avatar_anel"
            android:elevation="6dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_interno">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Logo ArthurBaby" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARTHURBABY"
            android:textColor="@color/rosa_arthur"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Obrigada por usar nosso app!"
            android:textColor="@color/cinza_medio"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sugira esse app para outras mamães 💕"
            android:textColor="@color/rosa_escuro"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <!-- Redes sociais -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <FrameLayout
                android:id="@+id/btnInstagram"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circulo_categoria_suave"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_instagram"
                    app:tint="@color/rosa_arthur"
                    android:contentDescription="Instagram" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnWhatsapp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circulo_verde_suave"
                android:layout_marginStart="16dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_whatsapp"
                    app:tint="@color/verde_arthur"
                    android:contentDescription="WhatsApp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnShopee"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circulo_categoria_suave"
                android:layout_marginStart="16dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shopee"
                    app:tint="@color/rosa_arthur"
                    android:contentDescription="Shopee" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@lojao_arthur_baby"
            android:textColor="@color/cinza_medio"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarInicio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:text="VOLTAR AO INÍCIO"
        android:backgroundTint="@color/rosa_arthur"
        android:textColor="@color/branco"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</RelativeLayout>