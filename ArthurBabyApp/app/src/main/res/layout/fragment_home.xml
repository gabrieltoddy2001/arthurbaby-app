<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_gradiente_header">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSaudacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ola"
                android:textColor="@color/branco_fixo"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bem_vinda_a_arthurbaby"
                android:textColor="@color/branco_fixo"
                android:textSize="@dimen/texto_pequeno"
                android:alpha="0.9"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnEntrarHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entrar_2"
            android:textColor="@color/rosa_arthur"
            android:textStyle="bold"
            android:textSize="@dimen/texto_corpo"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_botao_branco"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnFavoritos"
            android:tooltipText="Meus favoritos"
            android:contentDescription="@string/meus_favoritos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="@drawable/bg_circulo_branco_suave"
            android:src="@drawable/ic_favorito"
            app:tint="@color/rosa_arthur"
            android:visibility="gone" />

        <!-- Sair (só aparece logada), à direita do coração -->
        <TextView
            android:id="@+id/btnSairHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sair"
            android:textColor="@color/rosa_arthur"
            android:textStyle="bold"
            android:textSize="@dimen/texto_corpo"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_botao_branco"
            android:contentDescription="@string/sair_da_conta"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/verde_arthur"
        android:visibility="visible" />

    <!-- ERRO AO CARREGAR (servidor fora do ar ou sem internet) -->
    <LinearLayout
        android:id="@+id/layoutErroHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nao_foi_possivel_carregar_a_loja"
            android:textColor="@color/texto_primario"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/verifique_sua_internet_e_tente_de_novo_n"
            android:textColor="@color/cinza_medio"
            android:textSize="@dimen/texto_corpo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTentarNovamente"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/rosa_arthur"
            android:paddingHorizontal="28dp"
            android:text="@string/tentar_de_novo"
            android:textAllCaps="false"
            android:textColor="@color/branco_fixo"
            android:textSize="@dimen/texto_destaque"
            android:textStyle="bold"
            app:cornerRadius="26dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ATALHO DE BUSCA -->
            <LinearLayout
                android:id="@+id/atalhoBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_suave"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_busca"
                    app:tint="@color/rosa_arthur"
                    android:contentDescription="@string/buscar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buscar_produtos"
                    android:textColor="@color/cinza_texto"
                    android:textSize="@dimen/texto_corpo"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- BANNER -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_gradiente_pessego"
                    android:padding="24dp"
                    android:minHeight="160dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/conforto_e_carinho_para_o_seu_bebe"
                        android:textColor="@color/branco_fixo"
                        android:textSize="@dimen/texto_titulo"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/feito_com_amor"
                        android:textColor="@color/branco_fixo"
                        android:textSize="@dimen/texto_pequeno"
                        android:alpha="0.95"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ver_promocoes"
                        android:textSize="@dimen/texto_pequeno"
                        android:textStyle="bold"
                        android:backgroundTint="@color/branco"
                        android:textColor="@color/rosa_escuro"
                        android:paddingHorizontal="20dp"
                        android:minHeight="40dp"
                        app:cornerRadius="20dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CATEGORIAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/categorias"
                    android:textColor="@color/texto_primario"
                    android:textStyle="bold"
                    android:textSize="@dimen/texto_subtitulo" />

                <TextView
                    android:id="@+id/txtVerTodasCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ver_todas"
                    android:textColor="@color/rosa_arthur"
                    android:textSize="@dimen/texto_corpo"
                    android:padding="4dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="horizontal"
                android:scrollbarStyle="insideInset"
                android:fadeScrollbars="false"
                android:scrollbarSize="4dp"
                android:scrollbarThumbHorizontal="@drawable/bg_rolagem_thumb"
                android:scrollbarTrackHorizontal="@drawable/bg_rolagem_trilho"
                android:nestedScrollingEnabled="false" />

            <!-- PRODUTOS EM DESTAQUE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/produtos_em_destaque"
                    android:textColor="@color/texto_primario"
                    android:textStyle="bold"
                    android:textSize="@dimen/texto_subtitulo" />

                <TextView
                    android:id="@+id/txtVerTodosProdutos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ver_todos"
                    android:textColor="@color/rosa_arthur"
                    android:textSize="@dimen/texto_corpo"
                    android:padding="4dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>