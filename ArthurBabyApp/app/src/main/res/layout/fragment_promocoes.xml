<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/superficie">

    <!-- CABEÇALHO VERMELHO/ROSA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/rosa_arthur">

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="28sp"
            android:textColor="@color/branco"
            android:paddingEnd="16dp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_promocao"
            app:tint="@color/branco"
            android:contentDescription="Promoções" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Promoções"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- LISTA DE PRODUTOS EM PROMOÇÃO -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPromocoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>