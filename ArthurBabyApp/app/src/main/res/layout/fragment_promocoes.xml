<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_claro">

    <!-- CABEÇALHO COM GRADIENTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="@drawable/bg_gradiente_header">

        <ImageButton
            android:id="@+id/btnVoltar"
            style="@style/BotaoVoltar"
            app:tint="@color/branco" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <br.com.arthurbaby.utils.TituloComIcone
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/promocoes"
                    android:textSize="@dimen/texto_subtitulo"
                    android:textStyle="bold"
                    android:textColor="@color/branco"
                    app:iconeTitulo="@drawable/ic_promocao"

                    app:iconeClaro="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ofertas_especiais_para_voce"
                    android:textSize="@dimen/texto_pequeno"
                    android:textColor="@color/branco"
                    android:alpha="0.9" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/rosa_arthur"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPromocoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false" />

</LinearLayout>