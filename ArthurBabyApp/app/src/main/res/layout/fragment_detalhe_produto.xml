<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <!-- IMAGEM COM BARRA DE AÇÕES -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/bg_imagem_produto">

                <ImageView
                    android:id="@+id/imgProduto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Imagem do produto" />

                <!-- BARRA DE AÇÕES NO TOPO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/btnVoltar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/texto_primario"
                        android:contentDescription="Voltar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnCompartilhar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_compartilhar"
                        app:tint="@color/rosa_arthur"
                        android:contentDescription="Compartilhar"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/btnFavoritoDetalhe"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_favorito"
                        app:tint="@color/coracao_inativo"
                        android:contentDescription="Favorito" />
                </LinearLayout>
            </FrameLayout>

            <!-- CARD DE INFORMAÇÕES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Produto"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMarca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marca: ArthurBaby"
                        android:textColor="@color/cinza_medio"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <!-- ESTRELAS + PREÇO NA MESMA LINHA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvEstrelas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★"
                            android:textColor="@color/amarelo_estrela"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvAvaliacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(5.0)"
                            android:textColor="@color/cinza_texto"
                            android:textSize="12sp"
                            android:layout_marginStart="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvPrecoAntigo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/cinza_texto"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvPreco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>

                    <!-- DESCRIÇÃO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descrição"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza_medio"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD DE VARIAÇÕES (agrupado) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escolha as opções"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <!-- COR -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cor"
                        android:textColor="@color/cinza_medio"
                        android:textSize="13sp"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />

                    <!-- TAMANHO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamanho"
                        android:textColor="@color/cinza_medio"
                        android:textSize="13sp"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerTamanhos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />

                    <!-- MODELO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modelo"
                        android:textColor="@color/cinza_medio"
                        android:textSize="13sp"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerModelos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD DE QUANTIDADE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quantidade"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_contador_quantidade">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenos"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="-"
                            android:textSize="18sp"
                            android:backgroundTint="@color/branco"
                            android:textColor="@color/rosa_arthur"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp" />

                        <TextView
                            android:id="@+id/tvQtd"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/texto_primario" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMais"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:backgroundTint="@color/branco"
                            android:textColor="@color/rosa_arthur"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÃO FIXO NO RODAPÉ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/branco"
        android:elevation="8dp"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCarrinho"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ADICIONAR AO CARRINHO"
            android:backgroundTint="@color/rosa_arthur"
            android:textColor="@color/branco"
            android:textStyle="bold"
            android:textSize="14sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_carrinho"
            app:iconTint="@color/branco"
            app:iconGravity="textStart" />
    </LinearLayout>

</RelativeLayout>