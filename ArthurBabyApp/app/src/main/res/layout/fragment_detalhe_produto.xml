<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <!-- IMAGEM -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/branco">

                <!-- Carrossel de imagens -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerImagens"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp" />

                <!-- Bolinhas indicadoras -->
                <LinearLayout
                    android:id="@+id/indicadoresImagens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal" />

                <!-- Botões (mantidos iguais) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/btnVoltar"
                        android:tooltipText="Voltar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_voltar"
                        app:tint="@color/texto_primario"
                        android:contentDescription="@string/voltar" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnCompartilhar"
                        android:tooltipText="Compartilhar produto"
                        android:contentDescription="@string/compartilhar_produto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_compartilhar"
                        app:tint="@color/rosa_arthur"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/btnFavoritoDetalhe"
                        android:tooltipText="Adicionar aos favoritos"
                        android:contentDescription="@string/adicionar_aos_favoritos"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_circulo_branco_suave"
                        android:src="@drawable/ic_favorito"
                        app:tint="@color/coracao_inativo" />
                </LinearLayout>
            </FrameLayout>

            <!-- CARD DE INFORMAÇÕES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/produto"
                        android:textSize="@dimen/texto_titulo"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvMarca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marca_arthurbaby"
                        android:textColor="@color/cinza_medio"
                        android:textSize="@dimen/texto_pequeno"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvEstrelas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto"
                            android:textColor="@color/amarelo_estrela"
                            android:textSize="@dimen/texto_corpo" />

                        <TextView
                            android:id="@+id/tvAvaliacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_5_0"
                            android:textColor="@color/cinza_texto"
                            android:textSize="@dimen/texto_pequeno"
                            android:layout_marginStart="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvPrecoAntigo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/cinza_texto"
                            android:textSize="@dimen/texto_pequeno"
                            android:visibility="gone"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvPreco"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/r_0_00"
                            android:textSize="@dimen/texto_titulo"
                            android:textStyle="bold"
                            android:textColor="@color/rosa_arthur" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/descricao"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza_medio"
                        android:textSize="@dimen/texto_corpo"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAvaliar"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/avaliar_este_produto"
                        android:textAllCaps="false"
                        android:textSize="@dimen/texto_corpo"
                        android:textColor="@color/rosa_arthur"
                        app:strokeColor="@color/rosa_arthur"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD DE VARIAÇÕES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/escolha_as_opcoes"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cor"
                        android:textColor="@color/cinza_medio"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tamanho"
                        android:textColor="@color/cinza_medio"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerTamanhos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modelo"
                        android:textColor="@color/cinza_medio"
                        android:textSize="@dimen/texto_corpo"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/containerModelos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD DE QUANTIDADE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/quantidade"
                        android:textStyle="bold"
                        android:textColor="@color/texto_primario"
                        android:textSize="@dimen/texto_corpo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_contador_quantidade">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenos"
                            android:tooltipText="Diminuir quantidade"
                            android:contentDescription="@string/diminuir_quantidade"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="@string/texto_2"
                            android:textSize="@dimen/texto_subtitulo"
                            android:backgroundTint="@color/branco"
                            android:textColor="@color/rosa_arthur"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp" />

                        <TextView
                            android:id="@+id/tvQtd"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/n_1"
                            android:textSize="@dimen/texto_subtitulo"
                            android:textStyle="bold"
                            android:textColor="@color/texto_primario" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMais"
                            android:tooltipText="Aumentar quantidade"
                            android:contentDescription="@string/aumentar_quantidade"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="@string/texto_3"
                            android:textSize="@dimen/texto_subtitulo"
                            android:backgroundTint="@color/branco"
                            android:textColor="@color/rosa_arthur"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÃO FIXO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/branco"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCarrinho"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/adicionar_ao_carrinho"
            android:backgroundTint="@color/rosa_arthur"
            android:textColor="@color/branco_fixo"
            android:textStyle="bold"
            android:textSize="@dimen/texto_corpo"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_carrinho"
            app:iconTint="@color/branco_fixo"
            app:iconGravity="textStart" />
    </LinearLayout>

</RelativeLayout>